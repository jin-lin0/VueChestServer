{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ],
  "crons": [
    {
      "path": "/health",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/stock-digest/run",
      "schedule": "30 0 * * 1-5"
    },
    {
      "path": "/api/checkins/run",
      "schedule": "17 1 * * *"
    }
  ]
}
